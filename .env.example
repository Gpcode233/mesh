# Google AI Studio is the default provider for Mesh's agent chat.
MESH_AI_PROVIDER=google
GEMINI_API_KEY=
MESH_AI_MODEL=gemini-flash-lite-latest
MESH_AI_BASE_URL=
MESH_APP_URL=http://localhost:3000

# OpenRouter fallback:
# MESH_AI_PROVIDER=openrouter
# MESH_AI_API_KEY=
# MESH_AI_MODEL=openai/gpt-oss-20b:free

# Groq example:
# MESH_AI_PROVIDER=groq
# MESH_AI_MODEL=llama-3.3-70b-versatile
# MESH_AI_API_KEY=

# NEAR AI example: set the endpoint documented for your NEAR AI account.
# MESH_AI_PROVIDER=near
# MESH_AI_BASE_URL=
# MESH_AI_MODEL=
# MESH_AI_API_KEY=

# Database. Defaults to a local SQLite file; a libSQL URL also works.
# DATABASE_URL=file:./data/mesh.db
# DATABASE_AUTH_TOKEN=

# First operator, created by `npm run db:setup`. There is no public sign-up.
MESH_OPERATOR_EMAIL=
MESH_OPERATOR_PASSWORD=
# MESH_OPERATOR_NAME=Operator
# MESH_ORG_NAME=Mesh

# Per-user chat requests per minute, and sign-in attempts per email per 15 minutes.
# MESH_CHAT_RATE_LIMIT=30
# MESH_LOGIN_RATE_LIMIT=10
